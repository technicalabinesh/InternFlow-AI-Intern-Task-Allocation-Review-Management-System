# Application Environment
APP_NAME="InternFlow AI"
APP_ENV=development
SECRET_KEY=internflow-ai-super-secret-key-change-in-production
DEBUG=True

# Mode Configuration (Safe Demo Mode by default)
DEMO_MODE=True

# Database Configuration
DATABASE_URL=sqlite:///./internflow.db

# Storage Directories
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=25

# AI Provider Configuration
# Supported: mock, openai, gemini, anthropic
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Email Provider Configuration
# Supported: mock, gmail
EMAIL_PROVIDER=mock
GMAIL_CLIENT_SECRETS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
EMAIL_SENDER_NAME="InternFlow AI Coordinator"
EMAIL_SENDER_ADDRESS="coordinator@example.com"
EMAIL_RATE_LIMIT_PER_MINUTE=30
EMAIL_TEST_RECIPIENT="coordinator-test@example.com"

# Scheduling & Timezone
DEFAULT_TIMEZONE=Asia/Kolkata
